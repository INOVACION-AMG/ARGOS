# Supabase - Project Settings > Database > Connection string
# DATABASE_URL: usa el "Connection pooling" (puerto 6543)
# DIRECT_URL: usa la conexión directa (puerto 5432), la necesita Prisma para migraciones
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Anthropic (Claude) - para interpretar pedidos (texto/audio) y leer fotos (facturas, flyers)
ANTHROPIC_API_KEY=

# Transcripción de audio (notas de voz)
OPENAI_API_KEY=

# Número del proveedor Colver para el reporte nocturno (Fase 4), formato: 57XXXXXXXXXX
COLVER_WHATSAPP_NUMBER=

# Secreto para firmar los JWT de login de la app web (Factura Gerente)
JWT_SECRET=

# Si se configura, solo estos números (formato 57XXXXXXXXXX, separados por coma)
# pueden usar a Argos. Vacío = cualquiera que le escriba al número vinculado.
ARGOS_NUMEROS_AUTORIZADOS=

# API key para que otros sistemas del ecosistema AMG consulten GET /documentos.
# Vacío = la API queda abierta (uso local/pruebas).
ARGOS_API_KEY=

# --- Modo compartido D'Carnes / AMG (ver MODO-AMG.md) ---
MODO_BOT=dcarnes
AMG_SUPABASE_URL=
AMG_SUPABASE_SERVICE_ROLE_KEY=
AMG_COMERCIAL_ID=

# Green API (green-api.com) - conexión a WhatsApp. Panel: console.green-api.com
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=
